{
  "permissions": {
    "defaultMode": "default",
    "disableBypassPermissionsMode": "disable",
    "deny": [
      "Read(./data/**)",
      "Read(./sourcedata/**)",
      "Read(./derivatives/**)",
      "Read(**/.env)",
      "Read(**/*.key)",
      "Read(**/*.pem)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": false,
    "filesystem": {
      "denyRead": ["./data", "./sourcedata", "./derivatives", "~/.ssh"]
    }
  }
}
